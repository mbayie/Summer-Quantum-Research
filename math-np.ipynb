import numpy as np

#Basic math on arrays
a = np.array([10, 20, 30, 40])

print(a + 5)    # adds 5 to every element
print(a * 2)    # multiplies every element by 2
print(a ** 2)   # squares every element
print(a > 15)   # returns True/False for each element

#Math between 2 arrays 
a = np.array([1, 2, 3, 4])
b = np.array([10, 20, 30, 40])

print(a + b)   # adds element by element
print(a * b)   # multiplies element by element

#each operation happens poisiton by position so a[0] + b[0], a[1] + b[1], etc. 

#Useful built-infunctions
a = np.array([1, 2, 3, 4, 5])

print(a.sum())    # total of all elements
print(a.min())    # smallest value
print(a.max())    # largest value
print(a.mean())   # average